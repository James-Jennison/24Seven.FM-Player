# Non-secret deployment contract for the protected 24Seven.FM Player portal.
# This file deliberately contains no host address, document-root path, token,
# credential, or identifier. The promotion script discovers the live Webuzo
# mapping from Apache at run time.
SITE_ID=24seven-fm-player-portal
PRODUCTION_BRANCH=codex/onboarding-portal-production
PRODUCTION_REMOTE_REF=origin/codex/onboarding-portal-production
SITE_TYPE=static
PRODUCTION_DOMAIN=24sevenfmplayer.com
WEBUZO_DOMAIN=24sevenfmplayer.com
BUILD_COMMAND=./scripts/validate-onboarding-portal-release.sh
ARTIFACT_DIR=_site
HEALTHCHECK_URL=https://24sevenfmplayer.com/tester-portal.php
CLOUDFLARE_PROXY=true
POST_DEPLOY_CHECK=./scripts/verify-tester-portal-runtime.sh
